---
import Icon from './Icon.astro';
import { whatsappHref } from '../config/site';
interface Props { label: string; light?: boolean; compact?: boolean; arrow?: boolean; }
const { label, light = false, compact = false, arrow = false } = Astro.props;
---
<a href={whatsappHref} class:list={['button', { 'button--light': light, 'button--compact': compact }]}>
  {!arrow && <Icon name="whatsapp" />}<span>{label}</span>{arrow && <Icon name="arrow" />}
</a>
