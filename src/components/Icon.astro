---
interface Props { name: 'whatsapp' | 'arrow' | 'phone'; }
const { name } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === 'phone' && <path d="m8 3-4 1c-3 7 9 19 16 16l1-4-5-2-2 2a15 15 0 0 1-6-6l2-2-2-5Z" />}
  {name === 'whatsapp' && <><path d="M20.5 11.5a9 9 0 0 1-13.4 7.9L3 20.5l1.1-4.1a9 9 0 1 1 16.4-4.9Z" /><path d="m8.2 7.2-1 .6c-1.5 3.6 4.2 9.1 7.4 7.6l.9-1.3-2.7-1.4-.9 1a8.8 8.8 0 0 1-3.6-3.5l.9-.9-1-2.1Z" /></>}
</svg>
