---
import Brand from './Brand.astro';
import ContactButton from './ContactButton.astro';
import { sitePath } from '../config/site';
---
<header class="site-header"><div class="container header-inner">
  <Brand />
  <nav class="main-nav" aria-label="Menú principal"><a href={sitePath('viajes-de-empresa')} aria-current={Astro.url.pathname === sitePath('viajes-de-empresa') ? 'page' : undefined}>Empresas</a></nav>
  <details class="mobile-nav"><summary>Menú</summary><nav aria-label="Menú móvil"><a href={sitePath('viajes-de-empresa')} aria-current={Astro.url.pathname === sitePath('viajes-de-empresa') ? 'page' : undefined}>Empresas</a></nav></details>
  <ContactButton label="Hablemos por WhatsApp" compact />
</div></header>
